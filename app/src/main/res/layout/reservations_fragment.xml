<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragments.ReservationsFragment">

    <TextView
        android:layout_marginTop="60dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reservations_label"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp">

        <EditText
            android:id="@+id/reservation_date"
            android:layout_width="0dp"
            android:layout_height="43dp"
            android:layout_weight="1"
            android:clickable="false"
            android:cursorVisible="false"
            android:focusable="false"
            android:hint="@string/date"
            android:padding="10dp"
            android:background="@drawable/edit_text_style"
            android:textSize="14sp"
            android:textColorHint="@color/gray"
            android:textColor="@color/black"
            android:drawableEnd="@drawable/calendar_icon"
            android:drawableTint="@color/gray"/>

        <Button
            android:id="@+id/choose_reservation_date"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:backgroundTint="@color/dark_violet"
            android:textColor="@color/white"
            android:text="@string/show_scheduled_terms"
            android:layout_marginStart="10dp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/reservations_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"/>
</LinearLayout>
