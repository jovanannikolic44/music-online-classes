<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="40dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/course_details_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/no_image"
            android:src="@drawable/arrow_back_icon"
            android:background="@android:color/transparent"
            android:paddingEnd="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="RtlSymmetry"/>

        <ImageButton
            android:id="@+id/course_details_cart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/no_image"
            android:src="@drawable/courses_cart_icon"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <ImageView
            android:id="@+id/course_image"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:contentDescription="@string/no_image"
            android:src="@drawable/violina"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/course_details_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            android:scaleType="fitXY"/>

        <TextView
            android:id="@+id/course_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_name"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/course_image"
            app:layout_constraintStart_toStartOf="parent"
            android:paddingTop="20dp"/>

        <TextView
            android:id="@+id/course_professor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/professor"
            android:textSize="18sp"
            app:layout_constraintTop_toBottomOf="@id/course_name"
            app:layout_constraintStart_toStartOf="parent"
            android:paddingBottom="10dp"/>

        <TextView
            android:id="@+id/course_level_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_level"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/course_professor"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/course_level_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_level_beginner"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/course_professor"
            app:layout_constraintStart_toEndOf="@id/course_level_label"
            android:layout_marginStart="8dp"/>

        <TextView
            android:id="@+id/course_instrument_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_instrument"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/course_level_label"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/course_instrument_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/piano"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/course_level_value"
            app:layout_constraintStart_toEndOf="@id/course_instrument_label"
            android:layout_marginStart="8dp"/>

        <TextView
            android:id="@+id/course_rating_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_rating_s"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/course_instrument_label"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/course_rating_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/number"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/course_instrument_value"
            app:layout_constraintStart_toEndOf="@id/course_rating_label"
            android:layout_marginStart="8dp"/>

        <TextView
            android:id="@+id/course_price_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_price"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/course_rating_label"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/course_price_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/number"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/course_rating_value"
            app:layout_constraintStart_toEndOf="@id/course_price_label"
            android:layout_marginStart="8dp"/>

        <TextView
            android:id="@+id/course_description_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/course_description"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/course_price_label"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/course_description_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/course_description"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/course_description_label"
            app:layout_constraintStart_toStartOf="parent"
            android:paddingBottom="10dp"/>

        <TextView
            android:id="@+id/course_content_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/course_content"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/course_description_value"
            app:layout_constraintStart_toStartOf="parent"
            android:paddingTop="10dp"/>

        <TextView
            android:id="@+id/course_content_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/course_content_label"
            app:layout_constraintStart_toStartOf="parent"
            android:padding="5dp"
            android:maxLines="10"
            android:ellipsize="end"/>

        <EditText
            android:id="@+id/course_comment_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:autofillHints="text"
            android:hint="@string/course_comment_input"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/edit_text_style"
            android:inputType="textMultiLine"
            android:lines="4"
            android:maxLines="6"
            android:paddingStart="10dp"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/course_content_list"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone"
            tools:ignore="RtlSymmetry"/>

        <Button
            android:id="@+id/course_comment_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_save_comment"
            app:layout_constraintTop_toBottomOf="@id/course_comment_input"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/dark_violet"
            android:textColor="@color/white"
            android:visibility="gone"/>

        <Button
            android:id="@+id/add_course_to_cart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/dark_violet"
            android:textColor="@color/white"
            android:text="@string/add_to_cart"
            app:layout_constraintTop_toBottomOf="@id/course_comment_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/course_comments_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/course_comments"
            android:textSize="16sp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintTop_toBottomOf="@id/add_course_to_cart"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/comments_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/course_comments_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="200dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
